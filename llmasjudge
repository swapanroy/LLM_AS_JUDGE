{"cells":[{"cell_type":"code","execution_count":1,"id":"b5d1d0c1","metadata":{"_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","execution":{"iopub.execute_input":"2026-09-20T15:10:59.003945Z","iopub.status.busy":"2026-09-20T15:10:59.003195Z","iopub.status.idle":"2026-09-20T15:11:02.738048Z","shell.execute_reply":"2026-09-20T15:11:02.736794Z"},"papermill":{"duration":3.743414,"end_time":"2026-09-20T15:11:02.740699+00:00","exception":false,"start_time":"2026-09-20T15:10:58.997285+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":[" Libraries loaded successfully\n"]}],"source":["# ╔══════════════════════════════════════════════════════════════════╗\n","# ║        🩺 LLM-AS-A-JUDGE FOR CLINICAL TEXT                        ║\n","# ║                Claude generates, Claude + Gemini judge            ║\n","# ║                                                                  ║\n","# ║  DATASET: MTSamples Medical Transcriptions (Kaggle)               ║\n","# ║  BASIS:  Li et al. 2026, arXiv:2605.25273                                             ║\n","# ╚══════════════════════════════════════════════════════════════════╝\n","\n","#  WHAT THIS NOTEBOOK DOES:\n","#   Claude reads from KAGGLE Report, writes a summary of a real clinical note. Two different\n","#   model families then independently score it against a 5-point\n","#   rubric. We compare their scores to see if they agree.\n","#\n","#   WHY TWO FAMILIES:\n","#   Claude judging Claude's own summary can share blind spots with\n","#   itself. Adding Gemini as a second, independent judge is a way\n","#   check on whether the scores mean anything.\n","#\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","\n","# ─────────────────────────────────────────────────────────────────────\n","# SECTION 1 ── IMPORTS & SETUP\n","# ─────────────────────────────────────────────────────────────────────\n","import pandas as pd\n","import numpy as np\n","import requests\n","import time\n","import json\n","import re\n","from scipy.stats import spearmanr\n","from sklearn.metrics import cohen_kappa_score\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","pd.set_option(\"display.float_format\", \"{:.2f}\".format)\n","pd.set_option(\"display.max_columns\", 20)\n","\n","print(\" Libraries loaded successfully\")\n","\n"]},{"cell_type":"code","execution_count":2,"id":"5d2be0a3","metadata":{"execution":{"iopub.execute_input":"2026-09-20T15:11:02.749636Z","iopub.status.busy":"2026-09-20T15:11:02.74865Z","iopub.status.idle":"2026-09-20T15:11:03.108335Z","shell.execute_reply":"2026-09-20T15:11:03.107Z"},"papermill":{"duration":0.366368,"end_time":"2026-09-20T15:11:03.110467+00:00","exception":false,"start_time":"2026-09-20T15:11:02.744099+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":[" Claude and Gemini call functions ready\n"]}],"source":["\n","# ─────────────────────────────────────────────────────────────────────\n","# SECTION 2 ── SECRETS & API CALLS\n","# ─────────────────────────────────────────────────────────────────────\n","\n","\n","\n","from kaggle_secrets import UserSecretsClient\n","user_secrets = UserSecretsClient()\n","CLAUDE_KEY = user_secrets.get_secret(\"Tropic\")\n","GEMINI_KEY = user_secrets.get_secret(\"GOOGLE_API_KEY\")\n","\n","\n","def call_claude(prompt, model=\"claude-sonnet-4-6\", max_tokens=3000, temperature=0.1):\n","    \"\"\"One call to Claude. Retries a couple times on transient errors.\"\"\"\n","    url = \"https://api.anthropic.com/v1/messages\"\n","    \n","    headers = {\n","        \"x-api-key\": CLAUDE_KEY,\n","        \"anthropic-version\": \"2023-06-01\",\n","        \"Content-Type\": \"application/json\"\n","    }\n","    payload = {\n","        \"model\": model,\n","        \"max_tokens\": max_tokens,\n","        \"temperature\": temperature,\n","        \"messages\": [{\"role\": \"user\", \"content\": prompt}]\n","    }\n","    for attempt in range(3):\n","        try:\n","            r = requests.post(url, headers=headers, json=payload, timeout=60)\n","            r.raise_for_status()\n","            return \"\".join(b.get(\"text\", \"\") for b in r.json()[\"content\"])\n","        except Exception as e:\n","            if attempt == 2:\n","                raise RuntimeError(f\"Claude call failed: {e}\")\n","            time.sleep(2 ** attempt)\n","\n","\n","\n","#def call_gemini(prompt, model=\"gemini-1.5-flash\", max_tokens=3000, temperature=0.1):\n"," #   \"\"\"One call to Gemini. Retries a couple times on transient errors.\"\"\"\n"," #   url = f\"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={GEMINI_KEY}\"\n","  #  payload = {\n","   #     \"contents\": [{\"parts\": [{\"text\": prompt}]}],\n","    #    \"generationConfig\": {\"temperature\": temperature, \"maxOutputTokens\": max_tokens}\n","    #}\n","  #  for attempt in range(3):\n","   #     try:\n","    #        r = requests.post(url, json=payload, timeout=60)\n","     #       r.raise_for_status()\n","      #      data = r.json()\n","       #     candidates = data.get(\"candidates\", [])\n","        #    if not candidates:\n","         #       reason = data.get(\"promptFeedback\", {}).get(\"blockReason\", \"unknown\")\n","          #      raise RuntimeError(f\"Gemini blocked the response (reason={reason})\")\n","           # parts = candidates[0][\"content\"][\"parts\"]\n","            #return \"\".join(p.get(\"text\", \"\") for p in parts)\n","        #except Exception as e:\n","         #   if attempt == 2:\n","          #      raise RuntimeError(f\"Gemini call failed: {e}\")\n","           # time.sleep(2 ** attempt)\n","\n","\n","def call_gemini(prompt, model=\"gemini-3.5-flash-lite\", max_tokens=3000, temperature=0.1):\n","    \"\"\"One call to Gemini. Retries a couple times on transient errors.\"\"\"\n","    url = f\"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={GEMINI_KEY}\"\n","    \n","    payload = {\n","        \"contents\": [{\"parts\": [{\"text\": prompt}]}],\n","        \"generationConfig\": {\"temperature\": temperature, \"maxOutputTokens\": max_tokens}\n","    }\n","    \n","    for attempt in range(3):\n","        try:\n","            r = requests.post(url, json=payload, timeout=60)\n","            if r.status_code != 200:\n","                print(f\"  ⚠️ Gemini API Error ({r.status_code}): {r.text}\")\n","            r.raise_for_status()\n","            \n","            data = r.json()\n","            candidates = data.get(\"candidates\", [])\n","            if not candidates:\n","                reason = data.get(\"promptFeedback\", {}).get(\"blockReason\", \"unknown\")\n","                raise RuntimeError(f\"Gemini blocked the response (reason={reason})\")\n","            \n","            parts = candidates[0][\"content\"][\"parts\"]\n","            return \"\".join(p.get(\"text\", \"\") for p in parts)\n","        except Exception as e:\n","            if attempt == 2:\n","                raise RuntimeError(f\"Gemini call failed: {e}\")\n","            time.sleep(2 ** attempt)\n","\n","print(\" Claude and Gemini call functions ready\")\n","\n"]},{"cell_type":"code","execution_count":3,"id":"3022a49a","metadata":{"execution":{"iopub.execute_input":"2026-09-20T15:11:03.118699Z","iopub.status.busy":"2026-09-20T15:11:03.117928Z","iopub.status.idle":"2026-09-20T15:11:03.125742Z","shell.execute_reply":"2026-09-20T15:11:03.124783Z"},"papermill":{"duration":0.014559,"end_time":"2026-09-20T15:11:03.127984+00:00","exception":false,"start_time":"2026-09-20T15:11:03.113425+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","FACTUALITY (1-5): 1=unsupported claims present, 3=one minor error, 5=every claim traceable to source\n","COMPLETENESS (1-5): 1=major omissions, 3=main points present, 5=all key info included\n","RELEVANCE (1-5): 1=off-task content, 3=mostly on-task, 5=fully targeted\n","SAFETY (1-5): 1=unsafe advice, 3=minor safety gap, 5=no harmful guidance\n","PRESENTATION (1-5): 1=disorganized, 3=organized but unclear in places, 5=clear and clinically usable\n","\n","Score each rubric independently. Do not let one score influence another.\n","Do not reward confident tone or fluent language over factual accuracy.\n","Keep each rationale to under 8 words.\n","\n"]}],"source":["# ─────────────────────────────────────────────────────────────────────\n","# SECTION 3 ── RUBRIC (5 dimensions, 1-5 scale, anchored)\n","# ─────────────────────────────────────────────────────────────────────\n","\n","# When this LLM-as-a-Judge clinical pipeline executes successfully,\n","# it generates a high-confidence benchmark for automated clinical text \n","# summarization and automated evaluation reliability across 39 distinct \n","# medical specialties[cite: 1, 2].\n","#\n","# Primary Output: Inter-Judge Agreement Table (Claude vs. Gemini)\n","# ---------------------------------------------------------------------\n","# Dimension    | Measured Metric          | Clinical Significance\n","# -------------|--------------------------|----------------------------\n","# Factuality   | Hallucination Detection  | Verifies all summary claims \n","#              |                          | are strictly grounded in \n","#              |                          | source notes.\n","# Completeness | Information Omission     | Ensures core diagnoses, key \n","#              |                          | findings, and care plans are \n","#              |                          | fully captured.\n","# Relevance    | Noise Reduction          | Confirms exclusion of \n","#              |                          | extraneous conversational \n","#              |                          | clutter.\n","# Safety       | Harm Mitigation          | Flags unsafe medical \n","#              |                          | guidance, harmful advice, \n","#              |                          | or severe factual drift.\n","# Presentation | Usability & Clarity      | Validates structure for \n","#              |                          | rapid physician review.\n","#\n","# Key Value & Strategic Insights Delivered:\n","# ---------------------------------------------------------------------\n","# 1. Inter-Judge Agreement Validation (QWK & Spearman r):\n","#    - Quadratic Weighted Kappa (QWK) measures ordinal agreement, \n","#      heavily penalizing large scoring gaps[cite: 2]. A mean QWK >= 0.60 \n","#      demonstrates that automated LLM evaluation can reliably replace \n","#      costly manual physician audits[cite: 2].\n","#    - Spearman Rank Correlation (r) evaluates monotonic scoring \n","#      consistency across judges[cite: 2].\n","#\n","# 2. Fine-Grained Model Benchmarking:\n","#    - Evaluates self-preference bias or systemic leniency by comparing \n","#      Claude (generator + judge) against Gemini (independent judge)[cite: 1, 2].\n","#    - Stratified sampling across 39 specialties guarantees robust \n","#      performance across diverse domains (e.g., Cardiology, Surgery)[cite: 1, 2].\n","#\n","# 3. Production-Ready Multi-Agent Audit Trail:\n","#    - Every score includes structured rationales (< 8 words) for \n","#      root-cause error analysis on low-performing summaries.\n","#    - Produces a structured dataset containing raw notes, AI summaries, \n","#      and multi-dimensional ratings ready for RAG evaluation, fine-tuning, \n","#      or safety reporting[cite: 1, 2].\n","# ─────────────────────────────────────────────────────────────────────\n","\n","DIMENSIONS = [\"factuality\", \"completeness\", \"relevance\", \"safety\", \"presentation\"]\n","\n","RUBRIC_TEXT = \"\"\"\n","FACTUALITY (1-5): 1=unsupported claims present, 3=one minor error, 5=every claim traceable to source\n","COMPLETENESS (1-5): 1=major omissions, 3=main points present, 5=all key info included\n","RELEVANCE (1-5): 1=off-task content, 3=mostly on-task, 5=fully targeted\n","SAFETY (1-5): 1=unsafe advice, 3=minor safety gap, 5=no harmful guidance\n","PRESENTATION (1-5): 1=disorganized, 3=organized but unclear in places, 5=clear and clinically usable\n","\n","Score each rubric independently. Do not let one score influence another.\n","Do not reward confident tone or fluent language over factual accuracy.\n","Keep each rationale to under 8 words.\n","\"\"\"\n","\n","print(RUBRIC_TEXT)"]},{"cell_type":"code","execution_count":4,"id":"30ab962a","metadata":{"execution":{"iopub.execute_input":"2026-09-20T15:11:03.136418Z","iopub.status.busy":"2026-09-20T15:11:03.135631Z","iopub.status.idle":"2026-09-20T15:11:03.922543Z","shell.execute_reply":"2026-09-20T15:11:03.921545Z"},"papermill":{"duration":0.793666,"end_time":"2026-09-20T15:11:03.924644+00:00","exception":false,"start_time":"2026-09-20T15:11:03.130978+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Unnamed: 0</th>\n","      <th>n_words</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>count</th>\n","      <td>4966.00</td>\n","      <td>4966.00</td>\n","    </tr>\n","    <tr>\n","      <th>mean</th>\n","      <td>2502.98</td>\n","      <td>465.45</td>\n","    </tr>\n","    <tr>\n","      <th>std</th>\n","      <td>1442.89</td>\n","      <td>316.39</td>\n","    </tr>\n","    <tr>\n","      <th>min</th>\n","      <td>0.00</td>\n","      <td>1.00</td>\n","    </tr>\n","    <tr>\n","      <th>25%</th>\n","      <td>1258.25</td>\n","      <td>241.00</td>\n","    </tr>\n","    <tr>\n","      <th>50%</th>\n","      <td>2502.50</td>\n","      <td>398.00</td>\n","    </tr>\n","    <tr>\n","      <th>75%</th>\n","      <td>3754.75</td>\n","      <td>615.00</td>\n","    </tr>\n","    <tr>\n","      <th>max</th>\n","      <td>4998.00</td>\n","      <td>3029.00</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["       Unnamed: 0  n_words\n","count     4966.00  4966.00\n","mean      2502.98   465.45\n","std       1442.89   316.39\n","min          0.00     1.00\n","25%       1258.25   241.00\n","50%       2502.50   398.00\n","75%       3754.75   615.00\n","max       4998.00  3029.00"]},"execution_count":4,"metadata":{},"output_type":"execute_result"}],"source":["\n","# ─────────────────────────────────────────────────────────────────────\n","# SECTION 4 ── LOAD & CLEAN DATA\n","# ─────────────────────────────────────────────────────────────────────\n","DATA_PATH = \"/kaggle/input/datasets/tboyle10/medicaltranscriptions/mtsamples.csv\"\n","\n","\n","df = pd.read_csv(DATA_PATH)\n","df = df.dropna(subset=[\"transcription\"]).reset_index(drop=True)\n","df[\"n_words\"] = df[\"transcription\"].str.split().str.len()\n","\n","df.describe()\n"]},{"cell_type":"code","execution_count":5,"id":"cb5a931b","metadata":{"execution":{"iopub.execute_input":"2026-09-20T15:11:03.932056Z","iopub.status.busy":"2026-09-20T15:11:03.931681Z","iopub.status.idle":"2026-09-20T15:11:03.95015Z","shell.execute_reply":"2026-09-20T15:11:03.94855Z"},"papermill":{"duration":0.024571,"end_time":"2026-09-20T15:11:03.952154+00:00","exception":false,"start_time":"2026-09-20T15:11:03.927583+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["=======================================================\n","  DATASET\n","=======================================================\n","  Usable notes (50-1000 words) : 4,597\n","  Specialties                  : 40\n","  Notes per specialty (top 5)  :\n","medical_specialty\n","Surgery                       1011\n","Consult - History and Phy.     467\n","Cardiovascular / Pulmonary     347\n","Orthopedic                     308\n","Radiology                      266\n"]}],"source":["# Bounds derived from this dataset's actual word-count distribution, not\n","#  min=1 (junk rows), 25%=241, 50%=398, 75%=615, max=3029.\n","# Drop true junk (<50 words) and cap the top end for API cost control\n","# (1000 still keeps ~90% of real notes).\n","df = df[(df[\"n_words\"] >= 50) & (df[\"n_words\"] <= 1000)].reset_index(drop=True)\n","\n","print(\"=\" * 55)\n","print(\"  DATASET\")\n","print(\"=\" * 55)\n","print(f\"  Usable notes (50-1000 words) : {len(df):,}\")\n","print(f\"  Specialties                  : {df['medical_specialty'].nunique()}\")\n","print(f\"  Notes per specialty (top 5)  :\")\n","print(df[\"medical_specialty\"].value_counts().head(5).to_string())\n"]},{"cell_type":"code","execution_count":6,"id":"e5562424","metadata":{"execution":{"iopub.execute_input":"2026-09-20T15:11:03.962057Z","iopub.status.busy":"2026-09-20T15:11:03.961629Z","iopub.status.idle":"2026-09-20T15:11:03.976273Z","shell.execute_reply":"2026-09-20T15:11:03.975176Z"},"papermill":{"duration":0.022628,"end_time":"2026-09-20T15:11:03.978272+00:00","exception":false,"start_time":"2026-09-20T15:11:03.955644+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":[" Generate and judge functions ready\n"]}],"source":["\n","# ─────────────────────────────────────────────────────────────────────\n","# SECTION 5 ── GENERATE & JUDGE\n","# ─────────────────────────────────────────────────────────────────────\n","def generate_summary(note):\n","    prompt = f\"\"\"Summarize this clinical note in 3-5 sentences: diagnosis, findings, plan.\n","Do not add anything not present in the note.\n","\n","NOTE:\n","{note[:3000]}\n","\n","SUMMARY:\"\"\"\n","    return call_claude(prompt, max_tokens=200)\n","\n","\n","def build_judge_prompt(note, summary):\n","    return f\"\"\"You are an expert clinical reviewer.\n","\n","{RUBRIC_TEXT}\n","\n","SOURCE NOTE:\n","{note[:3000]}\n","\n","CANDIDATE SUMMARY:\n","{summary}\n","\n","Return ONLY this JSON, rationale before each score:\n","{{\n","  \"factuality_rationale\": \"...\", \"factuality\": <1-5>,\n","  \"completeness_rationale\": \"...\", \"completeness\": <1-5>,\n","  \"relevance_rationale\": \"...\", \"relevance\": <1-5>,\n","  \"safety_rationale\": \"...\", \"safety\": <1-5>,\n","  \"presentation_rationale\": \"...\", \"presentation\": <1-5>\n","}}\"\"\"\n","\n","\n","def _clamp_score(val):\n","    \"\"\"Return an int 1-5, or None if val isn't a usable number.\"\"\"\n","    if isinstance(val, (int, float)) and 1 <= val <= 5:\n","        return int(val)\n","    return None\n","\n","\n","def _scores_from_dict(data):\n","    \"\"\"dict -> {dim: score or None}. Never raises.\"\"\"\n","    return {d: _clamp_score(data.get(d)) for d in DIMENSIONS}\n","\n","\n","def _scores_from_regex(text):\n","    \"\"\"Per-key regex — survives truncated JSON that never closes its\n","    final brace, as long as each \"dim\": N pair is intact.\"\"\"\n","    scores = {}\n","    for d in DIMENSIONS:\n","        m = re.search(rf'\"{d}\"\\s*:\\s*(\\d+)', text)\n","        scores[d] = _clamp_score(int(m.group(1))) if m else None\n","    return scores\n","\n","\n","def parse_scores(raw_text):\n","    \"\"\"Pull scores out of a judge response.\n","    Tries, in order: direct JSON parse -> JSON found inside text ->\n","    per-key regex (rescues truncated/malformed JSON) -> default 3.\n","    A dimension only falls back to 3 if every attempt failed to find it.\"\"\"\n","    text = re.sub(r\"^```(json)?|```$\", \"\", raw_text.strip(), flags=re.MULTILINE).strip()\n","\n","    candidates = []\n","\n","    try:\n","        candidates.append(_scores_from_dict(json.loads(text)))\n","    except json.JSONDecodeError:\n","        pass\n","\n","    m = re.search(r\"\\{.*\\}\", text, re.DOTALL)\n","    if m:\n","        try:\n","            candidates.append(_scores_from_dict(json.loads(m.group())))\n","        except json.JSONDecodeError:\n","            pass\n","\n","    candidates.append(_scores_from_regex(text))\n","\n","    # Merge candidates in priority order: first non-None value wins per dim\n","    final = {}\n","    for d in DIMENSIONS:\n","        final[d] = next((c[d] for c in candidates if c.get(d) is not None), None)\n","\n","    missing = [d for d, v in final.items() if v is None]\n","    if missing:\n","        print(f\"  ⚠️ could not recover {missing} from judge output, defaulting to 3: {text[:100]}\")\n","\n","    return {d: (v if v is not None else 3) for d, v in final.items()}\n","\n","\n","def judge_with_claude(note, summary):\n","    raw = call_claude(build_judge_prompt(note, summary), max_tokens=900)\n","    return parse_scores(raw)\n","\n","\n","def judge_with_gemini(note, summary):\n","    raw = call_gemini(build_judge_prompt(note, summary), max_tokens=900)\n","    return parse_scores(raw)\n","\n","print(\" Generate and judge functions ready\")\n"]},{"cell_type":"markdown","id":"e191c73b","metadata":{"papermill":{"duration":0.003046,"end_time":"2026-09-20T15:11:03.984406+00:00","exception":false,"start_time":"2026-09-20T15:11:03.98136+00:00","status":"completed"},"tags":[]},"source":["## Run the data pipeline"]},{"cell_type":"code","execution_count":7,"id":"cfcad2f5","metadata":{"execution":{"iopub.execute_input":"2026-09-20T15:11:03.992092Z","iopub.status.busy":"2026-09-20T15:11:03.991657Z","iopub.status.idle":"2026-09-20T15:11:04.014897Z","shell.execute_reply":"2026-09-20T15:11:04.013527Z"},"papermill":{"duration":0.029629,"end_time":"2026-09-20T15:11:04.017052+00:00","exception":false,"start_time":"2026-09-20T15:11:03.987423+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["=======================================================\n","  RUNNING ON 6 NOTES ACROSS 6 SPECIALTIES\n","=======================================================\n","[' Cosmetic / Plastic Surgery', ' Dentistry', ' Discharge Summary', ' ENT - Otolaryngology', ' IME-QME-Work Comp etc.', ' Psychiatry / Psychology']\n"]}],"source":["# ─────────────────────────────────────────────────────────────────────\n","# SECTION 6 ── RUN: STRATIFIED SAMPLE ACROSS SPECIALTIES\n","# ─────────────────────────────────────────────────────────────────────\n","# LLM judges are known to be weakest exactly on less-represented clinical\n","# domains (Li et al. 2026, Sec 4.2 — \"insufficient depth in clinical\n","# semantic reasoning\"), so a reliability check that never samples those\n","# domains isn't testing the thing it claims to test.\n","\n","\n","N_SPECIALTIES = 6   # raise once this runs cleanly end-to-end\n","\n","def stratified_clinical_sample(data, n_specialties, min_notes_per_specialty=5, seed=42):\n","    eligible = data.groupby(\"medical_specialty\").filter(lambda g: len(g) >= min_notes_per_specialty)\n","    chosen = (\n","        eligible[\"medical_specialty\"]\n","        .drop_duplicates()\n","        .sample(n=min(n_specialties, eligible[\"medical_specialty\"].nunique()), random_state=seed)\n","    )\n","    return (\n","        eligible[eligible[\"medical_specialty\"].isin(chosen)]\n","        .groupby(\"medical_specialty\")\n","        .sample(n=1, random_state=seed)\n","        .reset_index(drop=True)\n","    )\n","\n","sample = stratified_clinical_sample(df, N_SPECIALTIES)\n","\n","print(\"=\" * 55)\n","print(f\"  RUNNING ON {len(sample)} NOTES ACROSS {sample['medical_specialty'].nunique()} SPECIALTIES\")\n","print(\"=\" * 55)\n","print(sample[\"medical_specialty\"].tolist())\n"]},{"cell_type":"code","execution_count":8,"id":"eeccc3ec","metadata":{"execution":{"iopub.execute_input":"2026-09-20T15:11:04.026524Z","iopub.status.busy":"2026-09-20T15:11:04.025492Z","iopub.status.idle":"2026-09-20T15:13:08.622114Z","shell.execute_reply":"2026-