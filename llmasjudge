─────────────────\n# SECTION 5 ── GENERATE & JUDGE\n# ─────────────────────────────────────────────────────────────────────\ndef generate_summary(note):\n    prompt = f\"\"\"Summarize this clinical note in 3-5 sentences: diagnosis, findings, plan.\nDo not add anything not present in the note.\n\nNOTE:\n{note[:3000]}\n\nSUMMARY:\"\"\"\n    return call_claude(prompt, max_tokens=200)\n\n\ndef build_judge_prompt(note, summary):\n    return f\"\"\"You are an expert clinical reviewer.\n\n{RUBRIC_TEXT}\n\nSOURCE NOTE:\n{note[:3000]}\n\nCANDIDATE SUMMARY:\n{summary}\n\nReturn ONLY this JSON, rationale before each score:\n{{\n  \"factuality_rationale\": \"...\", \"factuality\": <1-5>,\n  \"completeness_rationale\": \"...\", \"completeness\": <1-5>,\n  \"relevance_rationale\": \"...\", \"relevance\": <1-5>,\n  \"safety_rationale\": \"...\", \"safety\": <1-5>,\n  \"presentation_rationale\": \"...\", \"presentation\": <1-5>\n}}\"\"\"\n\n\ndef _clamp_score(val):\n    \"\"\"Return an int 1-5, or None if val isn't a usable number.\"\"\"\n    if isinstance(val, (int, float)) and 1 <= val <= 5:\n        return int(val)\n    return None\n\n\ndef _scores_from_dict(data):\n    \"\"\"dict -> {dim: score or None}. Never raises.\"\"\"\n    return {d: _clamp_score(data.get(d)) for d in DIMENSIONS}\n\n\ndef _scores_from_regex(text):\n    \"\"\"Per-key regex — survives truncated JSON that never closes its\n    final brace, as long as each \"dim\": N pair is intact.\"\"\"\n    scores = {}\n    for d in DIMENSIONS:\n        m = re.search(rf'\"{d}\"\\s*:\\s*(\\d+)', text)\n        scores[d] = _clamp_score(int(m.group(1))) if m else None\n    return scores\n\n\ndef parse_scores(raw_text):\n    \"\"\"Pull scores out of a judge response.\n    Tries, in order: direct JSON parse -> JSON found inside text ->\n    per-key regex (rescues truncated/malformed JSON) -> default 3.\n    A dimension only falls back to 3 if every attempt failed to find it.\"\"\"\n    text = re.sub(r\"^```(json)?|```$\", \"\", raw_text.strip(), flags=re.MULTILINE).strip()\n\n    candidates = []\n\n    try:\n        candidates.append(_scores_from_dict(json.loads(text)))\n    except json.JSONDecodeError:\n        pass\n\n    m = re.search(r\"\\{.*\\}\", text, re.DOTALL)\n    if m:\n        try:\n            candidates.append(_scores_from_dict(json.loads(m.group())))\n        except json.JSONDecodeError:\n            pass\n\n    candidates.append(_scores_from_regex(text))\n\n    # Merge candidates in priority order: first non-None value wins per dim\n    final = {}\n    for d in DIMENSIONS:\n        final[d] = next((c[d] for c in candidates if c.get(d) is not None), None)\n\n    missing = [d for d, v in final.items() if v is None]\n    if missing:\n        print(f\"  ⚠️ could not recover {missing} from judge output, defaulting to 3: {text[:100]}\")\n\n    return {d: (v if v is not None else 3) for d, v in final.items()}\n\n\ndef judge_with_claude(note, summary):\n    raw = call_claude(build_judge_prompt(note, summary), max_tokens=900)\n    return parse_scores(raw)\n\n\ndef judge_with_gemini(note, summary):\n    raw = call_gemini(build_judge_prompt(note, summary), max_tokens=900)\n    return parse_scores(raw)\n\nprint(\" Generate and judge functions ready\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T14:16:07.392581Z","iopub.execute_input":"2026-09-20T14:16:07.392867Z","iopub.status.idle":"2026-09-20T14:16:07.405811Z","shell.execute_reply.started":"2026-09-20T14:16:07.392844Z","shell.execute_reply":"2026-09-20T14:16:07.404534Z"}},"outputs":[{"name":"stdout","text":" Generate and judge functions ready\n","output_type":"stream"}],"execution_count":26},{"cell_type":"markdown","source":"## Run the data pipeline","metadata":{}},{"cell_type":"code","source":"# ─────────────────────────────────────────────────────────────────────\n# SECTION 6 ── RUN: STRATIFIED SAMPLE ACROSS SPECIALTIES\n# ─────────────────────────────────────────────────────────────────────\n# LLM judges are known to be weakest exactly on less-represented clinical\n# domains (Li et al. 2026, Sec 4.2 — \"insufficient depth in clinical\n# semantic reasoning\"), so a reliability check that never samples those\n# domains isn't testing the thing it claims to test.\n\n\nN_SPECIALTIES = 5   # raise once this runs cleanly end-to-end\n\ndef stratified_clinical_sample(data, n_specialties, min_notes_per_specialty=5, seed=42):\n    eligible = data.groupby(\"medical_specialty\").filter(lambda g: len(g) >= min_notes_per_specialty)\n    chosen = (\n        eligible[\"medical_specialty\"]\n        .drop_duplicates()\n        .sample(n=min(n_specialties, eligible[\"medical_specialty\"].nunique()), random_state=seed)\n    )\n    return (\n        eligible[eligible[\"medical_specialty\"].isin(chosen)]\n        .groupby(\"medical_specialty\")\n        .sample(n=1, random_state=seed)\n        .reset_index(drop=True)\n    )\n\nsample = stratified_clinical_sample(df, N_SPECIALTIES)\n\nprint(\"=\" * 55)\nprint(f\"  RUNNING ON {len(sample)} NOTES ACROSS {sample['medical_specialty'].nunique()} SPECIALTIES\")\nprint(\"=\" * 55)\nprint(sample[\"medical_specialty\"].tolist())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T14:16:12.138701Z","iopub.execute_input":"2026-09-20T14:16:12.13897Z","iopub.status.idle":"2026-09-20T14:16:12.155042Z","shell.execute_reply.started":"2026-09-20T14:16:12.138937Z","shell.execute_reply":"2026-09-20T14:16:12.154248Z"}},"outputs":[{"name":"stdout","text":"=======================================================\n  RUNNING ON 5 NOTES ACROSS 5 SPECIALTIES\n=======================================================\n[' Cosmetic / Plastic Surgery', ' Dentistry', ' Discharge Summary', ' ENT - Otolaryngology', ' Psychiatry / Psychology']\n","output_type":"stream"}],"execution_count":27},{"cell_type":"code","source":"# ─────────────────────────────────────────────────────────────────────\n# SECTION 2 ── SECRETS & API CALLS\n# ─────────────────────────────────────────────────────────────────────\nimport requests\nimport time\nfrom kaggle_secrets import UserSecretsClient\n\nuser_secrets = UserSecretsClient()\nGEMINI_KEY = user_secrets.get_secret(\"GOOGLE_API_KEY\")\nCLAUDE_KEY = user_secrets.get_secret(\"Tropic\")\n\n\ndef call_claude(prompt, model=\"claude-3-5-sonnet-latest\", max_tokens=3000, temperature=0.1):\n    \"\"\"One call to Claude. Retries a couple times on transient errors.\"\"\"\n    url = \"https://api.anthropic.com/v1/messages\"\n    headers = {\n        \"x-api-key\": CLAUDE_KEY,\n        \"anthropic-version\": \"2023-06-01\",\n        \"Content-Type\": \"application/json\"\n    }\n    payload = {\n        \"model\": model,\n        \"max_tokens\": max_tokens,\n        \"temperature\": temperature,\n        \"messages\": [{\"role\": \"user\", \"content\": prompt}]\n    }\n    for attempt in range(3):\n        try:\n            r = requests.post(url, headers=headers, json=payload, timeout=60)\n            if r.status_code != 200:\n                print(f\"  ⚠️ Claude API Error ({r.status_code}): {r.text}\")\n            r.raise_for_status()\n            \n            data = r.json()\n            return \"\".join(\n                b.get(\"text\", \"\") \n                for b in data.get(\"content\", []) \n                if b.get(\"type\") == \"text\"\n            )\n        except Exception as e:\n            if attempt == 2:\n                raise RuntimeError(f\"Claude call failed: {e}\")\n            time.sleep(2 ** attempt)\n\n\ndef call_gemini(prompt, model=\"gemini-1.5-flash\", max_tokens=3000, temperature=0.1):\n    \"\"\"One call to Gemini. Retries a couple times on transient errors.\"\"\"\n    url = f\"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={GEMINI_KEY}\"\n    payload = {\n        \"contents\": [{\"parts\": [{\"text\": prompt}]}],\n        \"generationConfig\": {\"temperature\": temperature, \"maxOutputTokens\": max_tokens}\n    }\n   